    "node-polyfill-webpack-plugin": "4.1.0",
    "raf": "3.4.1",
    "react-test-renderer": "16.14.0",
    "redux-mock-store": "1.5.5",
    "rimraf": "6.1.3",
    "selenium-webdriver": "4.48.0",
