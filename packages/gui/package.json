{
  "name": "openblock-gui",
  "version": "0.1.0",
  "description": "GraphicaL User Interface for creating and running OpenBlock projects",
  "main": "./dist/scratch-gui.js",
  "scripts": {
    "build": "npm run clean && webpack --color --bail",
    "build:production": "npm run clean && cross-env CI=true NODE_ENV=production webpack --mode production --color --bail",
    "dist": "npm run clean && cross-env CI=true NODE_ENV=production BUILD_MODE=dist webpack --mode production --color --bail",
    "clean": "rimraf ./build && mkdirp build && rimraf ./dist && mkdirp dist",
    "deploy": "touch build/.nojekyll && gh-pages -t -d build -m \"Build for $(git log --pretty=format:%H -n1) [skip ci]\"",
    "prune": "./prune-gh-pages.sh",
    "i18n:push": "tx-push-src openblock-editor interface translations/en.json",
    "i18n:src": "rimraf ./translations/messages/src && babel src > tmp.js && rimraf tmp.js && build-i18n-src ./translations/messages/src ./translations/",
    "start": "webpack-dev-server --open --host 0.0.0.0",
    "test": "npm run test:lint && npm run test:unit && npm run build && npm run test:integration",
    "test:integration": "jest --runInBand test[\\\\/]integration",
    "test:lint": "eslint . --ext .js,.jsx --fix",
    "test:unit": "",
    "test:smoke": "jest --runInBand test[\\\\/]smoke",
    "watch": "webpack --color --watch"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/openblockcc/openblock-gui#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/openblockcc/openblock-gui.git"
  },
  "dependencies": {
    "@ramonak/react-progress-bar": "^5.4.0",
    "ansi-to-react": "6.1.6",
    "arraybuffer-loader": "^1.0.8",
    "autoprefixer": "^10.5.4",
    "babel-plugin-react-intl": "^3.5.1",
    "base64-loader": "1.0.0",
    "bowser": "1.9.4",
    "classnames": "2.5.1",
    "computed-style-to-inline-style": "4.0.0",
    "copy-webpack-plugin": "^14.0.0",
