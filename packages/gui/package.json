    "openblock-blocks": "file:../blocks",
    "openblock-l10n": "file:../l10n",
    "openblock-save-svg-as-png": "^1.4.18",
    "openblock-vm": "file:../vm",
    "papaparse": "5.7.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
