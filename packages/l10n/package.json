{
    "name": "openblock-l10n",
    "version": "3.10.0",
    "description": "Localization for the Openblock components",
    "main": "./dist/l10n.js",
    "browser": "./src/index.js",
    "bin": {
        "build-i18n-src": "./scripts/build-i18n-src.js",
        "tx-push-src": "./scripts/tx-push-src.js"
    },
    "scripts": {
        "build:data": "babel-node scripts/build-data",
        "build": "npm run clean && npm run build:data && webpack --color --bail",
        "clean": "rimraf ./dist ./locales && mkdirp dist locales",
        "lint:js": "eslint . --ext .js",
        "lint:json": "jshint -e .json www editor/blocks editor/extensions editor/interface editor/paint-editor",
        "lint": "npm run lint:js && npm run lint:json",
        "pull:interface": "babel-node scripts/tx-pull-translations openblock-editor interface ./editor/interface/",
        "pull:paint": "babel-node scripts/tx-pull-translations openblock-editor paint-editor ./editor/paint-editor/",
        "pull:extensions": "babel-node scripts/tx-pull-translations openblock-editor extensions ./editor/extensions/",
        "pull:blocks": "babel-node scripts/tx-pull-blocks ./editor/blocks/",
        "pull:editor": "npm run pull:blocks && npm run pull:extensions && npm run pull:paint && npm run pull:interface",
        "pull:desktop": "babel-node scripts/tx-pull-translations openblock-editor desktop ./editor/desktop/",
        "pull:linkDesktop": "babel-node scripts/tx-pull-translations openblock-editor link-desktop ./editor/link-desktop/",
        "pull:www": "",
        "pull": "npm run pull:editor && npm run pull:desktop && npm run pull:linkDesktop",
        "pull:help:names": "./scripts/tx-pull-help-names.js",
        "pull:help:articles": "./scripts/tx-pull-help-articles.js",
        "pull:help": "npm run pull:help:names && npm run pull:help:articles",
        "push:help": "./scripts/tx-push-help.js",
        "sync:help": "npm run push:help && npm run pull:help",
        "test": "npm run lint:js && npm run validate:editor && npm run validate:www && npm run build && npm run lint:json",
        "update": "scripts/update-translations.sh",
        "validate:blocks": "babel-node scripts/validate-translations ./editor/blocks/",
        "validate:extensions": "babel-node scripts/validate-translations ./editor/extensions/ && babel-node scripts/validate-extension-inputs",
        "validate:interface": "babel-node scripts/validate-translations ./editor/interface/",
        "validate:paint": "babel-node scripts/validate-translations ./editor/paint-editor/",
        "validate:editor": "npm run validate:blocks && npm run validate:extensions && npm run validate:interface && npm run validate:paint",
        "validate:www": "babel-node scripts/validate-www ./www"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/openblockcc/openblock-l10n.git"
    },
    "author": "Massachusetts Institute of Technology",
    "license": "BSD-3-Clause",
    "bugs": {
        "url": "https://github.com/openblockcc/openblock-l10n/issues"
    },
    "homepage": "https://github.com/openblockcc/openblock-l10n#readme",
    "devDependencies": {
        "@babel/cli": "^7.29.7",
        "@babel/core": "^7.29.7",
        "@babel/node": "7.29.7",
        "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
        "@babel/plugin-syntax-dynamic-import": "^7.8.3",
        "@babel/plugin-transform-async-to-generator": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@babel/preset-react": "^7.29.7",
        "async": "3.2.6",
        "babel-eslint": "^10.1.0",
        "babel-loader": "9.2.1",
        "babel-plugin-react-intl": "^3.5.1",
        "eslint": "^9.39.5",
        "eslint-config-scratch": "^14.1.61",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "format-message-cli": "6.2.4",
        "format-message-parse": "6.2.4",
        "glob": "13.0.6",
        "jshint": "2.13.6",
        "json": "^11.0.0",
        "jsonlint": "1.6.3",
        "lodash.defaultsdeep": "4.6.1",
        "mkdirp": "^3.0.1",
        "node-fetch": "^2.7.0",
        "p-limit": "7.3.1",
        "p-queue": "9.3.3",
        "react-intl": "^2.9.0",
        "rimraf": "^6.1.3",
        "transifex": "1.6.6",
        "webpack": "^5.110.2",
        "webpack-cli": "^7.2.3"
    }
}
