{
  "name": "openblock-vm",
  "version": "0.2.0",
  "description": "Virtual Machine for OpenBlock",
  "author": "Massachusetts Institute of Technology",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/openblockcc/openblock-vm#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/openblockcc/openblock-vm.git"
  },
  "main": "./dist/node/openblock-vm.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "cross-env CI=true NODE_ENV=production webpack --mode production --color --bail",
    "build:production": "cross-env CI=true NODE_ENV=production webpack --mode production --color --bail",
    "coverage": "tap ./test/{unit,integration}/*.js --coverage --coverage-report=lcov",
    "deploy": "touch playground/.nojekyll",
    "docs": "jsdoc -c .jsdoc.json",
    "i18n:src": "mkdirp translations/core && format-message extract --out-file translations/core/en.json src/extensions/**/**.js src/devices/**/**.js",
    "i18n:push": "tx-push-src openblock-editor extensions translations/core/en.json",
    "lint": "eslint . && format-message lint src/**/*.js",
    "prepublish": "in-publish && npm run build || not-in-publish",
    "start": "BUILD_PLAYGROUND=true webpack serve",
    "tap": "",
    "tap:unit": "",
    "tap:integration": "",
    "test": "npm run lint && npm run docs && npm run tap",
    "watch": "webpack --color --watch",
    "version": "json -f package.json -I -e \"this.repository.sha = '$(git log -n1 --pretty=format:%H)'\""
  },
  "dependencies": {
    "@vernier/godirect": "1.8.3",
    "arraybuffer-loader": "^1.0.8",
    "atob": "2.1.2",
    "btoa": "1.2.1",
    "canvas-toBlob": "1.0.0",
    "decode-html": "2.0.0",
    "diff-match-patch": "1.0.5",
    "format-message": "6.2.4",
    "htmlparser2": "3.10.0",
    "immutable": "4.3.9",
    "jszip": "^3.10.1",
    "loadjs": "^4.3.0",
    "minilog": "3.1.0",
    "node-fetch": "^2.7.0",
    "scratch-parser": "5.2.1",
    "scratch-sb1-converter": "0.2.7",
    "scratch-translate-extension-languages": "0.0.20191118205314",
    "sweetalert": "^2.1.2",
    "text-encoding": "0.7.0",
    "worker-loader": "^3.0.8"
  },
  "peerDependencies": {
    "scratch-svg-renderer": "^0.2.0-prerelease"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "adm-zip": "0.6.0",
    "babel-eslint": "10.1.0",
    "babel-loader": "9.2.1",
    "callsite": "1.0.0",
    "copy-webpack-plugin": "14.0.0",
    "docdash": "2.0.2",
    "eslint": "9.39.5",
    "eslint-config-scratch": "14.1.61",
    "expose-loader": "5.0.1",
    "file-loader": "6.2.0",
    "format-message-cli": "6.2.4",
    "in-publish": "2.0.1",
    "jsdoc": "4.0.5",
    "json": "^11.0.0",
    "lodash.defaultsdeep": "4.6.1",
    "node-polyfill-webpack-plugin": "4.1.0",
    "openblock-blocks": "file:../blocks",
    "openblock-l10n": "file:../l10n",
    "pngjs": "7.0.0",
    "scratch-audio": "0.1.0-prerelease.20200528195344",
    "scratch-render": "0.1.0-prerelease.20211028200436",
    "scratch-render-fonts": "1.0.0-prerelease.20210401210003",
    "scratch-storage": "1.3.6",
    "scratch-svg-renderer": "0.2.0-prerelease.20210727023023",
    "script-loader": "0.7.2",
    "stats.js": "0.17.0",
    "tap": "21.7.5",
    "tiny-worker": "2.3.0",
    "webpack": "5.110.2",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  }
}
