{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBlock",
  "version": "2.5.0",
  "identifier": "cc.openblock.desktop",
  "build": {
    "beforeDevCommand": "npm run build",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "url": "index.html?runtime=desktop",
        "decorations": false,
        "fullscreen": false,
        "resizable": true,
        "focus": true,
        "minWidth": 1024,
        "minHeight": 700,
        "width": 1440,
        "height": 900
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
